{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HammerOverlay",
  "version": "0.1.4",
  "identifier": "com.hammer-overlay.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HammerOverlay",
        "width": 480,
        "minWidth": 400,
        "minHeight": 100,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "tabbingIdentifier": "main",
        "backgroundColor": "#1a1a1a"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "tooltip": "HammerOverlay - Discord Timestamp Converter"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "resources": {
      "sidecars/hammer-overlay-api/": "api",
      "../scripts/start-temporal-peft-server.ps1": "local-slm-runtime/scripts/start-temporal-peft-server.ps1",
      "../scripts/start-temporal-peft-server-container.ps1": "local-slm-runtime/scripts/start-temporal-peft-server-container.ps1",
      "../ml/temporal-ir/serve_peft_openai.py": "local-slm-runtime/ml/temporal-ir/serve_peft_openai.py",
      "../ml/temporal-ir/predict_peft.py": "local-slm-runtime/ml/temporal-ir/predict_peft.py",
      "../ml/temporal-ir/peft_runtime.py": "local-slm-runtime/ml/temporal-ir/peft_runtime.py",
      "../ml/temporal-ir/temporal_ir_prompts.py": "local-slm-runtime/ml/temporal-ir/temporal_ir_prompts.py",
      "../ml/temporal-ir/requirements-peft-server.txt": "local-slm-runtime/ml/temporal-ir/requirements-peft-server.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "globalShortcut": {
      "all": true
    },
    "sql": {
      "preload": ["sqlite:hammer_overlay.db"]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/BASIC-BIT/discord-time-app/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1QjY0OTJBQjJCMEI3NTYKUldSV3Q3Q3lLa20yWlNjajhEbkdtSC9Ncjc0bWRialQxTW1WMUZESEF1UjNBeUg4WnllMTBORHkK"
    }
  }
}
