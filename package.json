{
  "name": "hammer-overlay",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev-hammer-overlay.ps1",
    "build": "vite build",
    "test": "npm run test:routing && npm run test:manual && npm run test:relay && npm --prefix api test",
    "test:routing": "node --test shared/discord-timestamp-routing/index.test.cjs",
    "build:api": "npm --prefix api run build",
    "reload:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\reload-local-parser-api.ps1",
    "prepare:api-sidecar": "node scripts/prepare-api-sidecar.mjs",
    "build:desktop": "npm run build:api && npm run prepare:api-sidecar && npm run build",
    "tauri:build": "tauri build",
    "tauri:build:routing-smoke": "tauri build --config src-tauri/tauri.routing-smoke.conf.json --features routing-smoke",
    "verify:installed:routing-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-installed-routing-smoke.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "tauri dev",
    "test:desktop": "python3 scripts/desktop_smoke.py",
    "test:manual": "node --test src/lib/manualDateTime.test.ts",
    "test:relay": "vitest run convex/temporal.test.ts src/lib/hosted-parser.test.ts src/lib/hosted-auth.test.ts src/lib/clipboard.test.ts src/components/HostedAccount.test.tsx src/components/Overlay.test.tsx"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "0.4.3",
    "@hammer-overlay/discord-timestamp-routing": "file:shared/discord-timestamp-routing",
    "@js-temporal/polyfill": "0.5.1",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-notification": "~2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "chrono-node": "^2.9.1",
    "convex": "1.51.0",
    "moment": "^2.30.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "convex-test": "0.0.73",
    "jsdom": "31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "5.1.1"
  }
}
